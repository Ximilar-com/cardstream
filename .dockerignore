# Keep the build context to what `pip install .` needs: pyproject, README, src/
# (src/cardstream/webui/ is package data the UI serves — never ignore it).
.git
.venv
**/__pycache__
*.egg-info
.pytest_cache
dist
tests
model/
*.mp4
# `make dev` writes these (--store-images); several MB of JPEGs otherwise land
# in every build context.
images/
frame/
.env
